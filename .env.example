# Mẫu cấu hình. Copy file này thành ".env" rồi điền giá trị thật.
# File .env chứa bí mật -> KHÔNG BAO GIỜ commit lên GitHub (đã có trong .gitignore).

# ---- Server ----
# 1 = chế độ phát triển (tự nạp lại khi sửa code, hiện trang lỗi chi tiết).
# Để 0 khi demo cho người khác vào qua Wi-Fi.
FLASK_DEBUG=0
PORT=5000
# Múi giờ của kho, tính bằng giờ lệch so với UTC (Việt Nam = 7). Dùng cho "hôm nay" khi xét hạn dùng,
# FEFO, đúng hạn giao (OTIF) và giờ ghi sổ. Không phụ thuộc giờ của máy chủ.
TZ_OFFSET=7

# ---- LLM cho trợ lý Kvis ----
# OpenRouter: tạo key tại https://openrouter.ai/settings/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Dùng 1 model cố định có hỗ trợ gọi tool. Đừng dùng "openrouter/free": OpenRouter chọn ngẫu nhiên,
# có model không gọi được tool. Danh sách model: https://openrouter.ai/models
LLM_MODEL=google/gemma-4-31b-it:free
# 1 = Kvis tự gọi tool để tra số liệu (mặc định). 0 = tắt tool, Kvis trả lời từ ảnh chụp số liệu
# dán sẵn vào prompt (dùng khi model không hỗ trợ tool; model báo không hỗ trợ thì Kvis cũng tự lui về cách này).
LLM_TOOLS=1

# Muốn dùng LM Studio chạy trên máy thì đổi thành:
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=<tên model đang mở trong LM Studio>

# Tên/địa chỉ app (tùy chọn, hiện trong bảng xếp hạng app của OpenRouter)
APP_URL=http://localhost:5000
APP_NAME=StockOps
