# Mẫu cấu hình. Copy file này thành ".env" rồi điền giá trị thật.
# File .env chứa bí mật -> KHÔNG BAO GIỜ commit lên GitHub (đã có trong .gitignore).

# ---- Server ----
# 1 = chế độ phát triển (tự nạp lại khi sửa code, hiện trang lỗi chi tiết).
# Để 0 khi demo cho người khác vào qua Wi-Fi.
FLASK_DEBUG=0
PORT=5000

# ---- LLM cho trợ lý Kvis ----
# OpenRouter: tạo key tại https://openrouter.ai/settings/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free

# Muốn dùng LM Studio chạy trên máy thì đổi thành:
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=<tên model đang mở trong LM Studio>

# Tên/địa chỉ app (tùy chọn, hiện trong bảng xếp hạng app của OpenRouter)
APP_URL=http://localhost:5000
APP_NAME=StockOps
